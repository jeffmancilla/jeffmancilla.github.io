---
const { title } = Astro.props;
import "./src/styles/global.css";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
    </head>
    <body>
        <main>
            <slot />
        </main>
        <footer>
            <aside>
                <div class="flex flex-column gap-1">
                    <p>© 2025 Jeff Mancilla</p>
                    <p>
                        Built with ♥ and <a
                            href="https://astro.build"
                            target="_blank"
                            rel="noopener">Astro</a
                        >
                    </p>
                </div>
            </aside>
            <nav>
                <h6>Connect</h6>
                <a href="https://linkedin.com/in/jeffmancilla">LinkedIn</a>
                <a href="https://github.com/jeffmancilla">GitHub</a>
                <a
                    href="https://docs.google.com/document/d/1-su0iiz5x2GoJ1Cf8hGFCd5tDf2QrUD1E6Md5Bu0njg/edit?usp=sharing"
                    >Resume</a
                >
                <a href="mailto:jeffmancilla@outlook.com">Email</a>
            </nav>
            <nav>
                <h6>Nav</h6>
                <a href="#projects">Projects</a>
                <a href="#top">Back to top</a>
            </nav>
        </footer>
    </body>
</html>

<style is:global>
    @import "../styles/main.css";

    body {
        width: min(100% - 4rem, 768px);
        height: 100svh;
        margin-inline: auto;
        display: flex-column;
    }
    main {
        flex-grow: 1;
    }
</style>
