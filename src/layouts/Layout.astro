---
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
    </head>
    <body>
        <header></header>
        <main>
            <slot />
        </main>
        <footer></footer>
    </body>
</html>

<style>
    @import "../styles/main.css";
</style>
